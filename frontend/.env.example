# URL du backend Cloudflare Worker de génération de plan (optionnel — sans elle, le générateur local prend le relais)
VITE_BACKEND_URL=

# Access key publique Web3Forms (web3forms.com) pour le formulaire de contact du footer
VITE_WEB3FORMS_ACCESS_KEY=

# Clé publique Clerk (dashboard.clerk.com > API Keys > Publishable key)
# Sans elle, l'app tourne en mode démo : connexion simulée en local, aucun compte réel.
VITE_CLERK_PUBLISHABLE_KEY=

# ID du prix Stripe (mode récurrent) pour l'abonnement Pro — dashboard.stripe.com > Produits
VITE_STRIPE_PRICE_ID=

# Scripts tiers de la bannière cookies (catégories "Statistiques"/"Marketing") — ne sont
# chargés que si l'utilisateur y consent explicitement (voir lib/consentScripts.js). Sans
# ces valeurs, les catégories restent visibles dans la bannière mais ne chargent rien.

# Token du site Cloudflare Web Analytics (dashboard Cloudflare > Web Analytics > Add a site
# > Manual setup, copier le "token" du snippet — PAS besoin d'ajouter le snippet vous-même,
# juste le token)
VITE_CF_BEACON_TOKEN=

# ID du pixel Meta/Facebook (business.facebook.com > Gestionnaire d'événements)
VITE_FB_PIXEL_ID=

# Partner ID du LinkedIn Insight Tag (LinkedIn Campaign Manager > Analyser > Insight Tag)
VITE_LINKEDIN_PARTNER_ID=
